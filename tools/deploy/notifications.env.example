# WeCom group robot webhook. This URL contains a secret key.
MAIBIDA_WECOM_WEBHOOK_URL=

# Optional SMTP notification. Port 465 uses implicit TLS via curl.
MAIBIDA_SMTP_HOST=
MAIBIDA_SMTP_PORT=465
MAIBIDA_SMTP_USER=
MAIBIDA_SMTP_PASS=
MAIBIDA_SMTP_FROM=
MAIBIDA_EMAIL_TO=

MAIBIDA_NOTIFY_TIMEOUT_MS=15000
