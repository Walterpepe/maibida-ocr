# WeCom group robot webhook. This URL contains a secret key.
# Create it in a WeCom group: Group settings -> Group robot -> Add robot.
# MAIBIDA_WECOM_WEBHOOK_URL="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=..."
MAIBIDA_WECOM_WEBHOOK_URL=

# Optional SMTP notification. Port 465 uses implicit TLS via curl.
# Tencent Exmail example:
# MAIBIDA_SMTP_HOST=smtp.exmail.qq.com
# MAIBIDA_SMTP_PORT=465
# MAIBIDA_SMTP_USER=sales@maibida.com
# MAIBIDA_SMTP_PASS="SMTP authorization code"
# MAIBIDA_SMTP_FROM=sales@maibida.com
# MAIBIDA_EMAIL_TO="sales@maibida.com,owner@maibida.com"
MAIBIDA_SMTP_HOST=
MAIBIDA_SMTP_PORT=465
MAIBIDA_SMTP_USER=
MAIBIDA_SMTP_PASS=
MAIBIDA_SMTP_FROM=
MAIBIDA_EMAIL_TO=

MAIBIDA_NOTIFY_TIMEOUT_MS=15000
