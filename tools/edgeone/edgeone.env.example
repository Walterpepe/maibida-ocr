# Tencent Cloud API credentials. Keep the real file outside the repository.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# Use teo.tencentcloudapi.com for a mainland Tencent Cloud account.
# Use TENCENTCLOUD_REGION=intl for teo.intl.tencentcloudapi.com.
# TENCENTCLOUD_ENDPOINT=https://teo.tencentcloudapi.com
# TENCENTCLOUD_REGION=

EDGEONE_ZONE_ID=zone-3x9ct40r4u3w
EDGEONE_HOST=www.maibida.com
EDGEONE_FUNCTION_NAME=maibida-contact-api

# Live Maibida EdgeOne resources. Override these if the zone is recreated.
EDGEONE_FUNCTION_ID=ef-gve3hyp7
EDGEONE_FUNCTION_RULE_ID=rule-duda03jj
EDGEONE_HTML_CACHE_MODE=stable
EDGEONE_HTML_CACHE_TTL=600
EDGEONE_HTML_CACHE_RULE_NAME=maibida-html-node-cache

# Set to 1 when a deployment must fail instead of warning about missing EdgeOne.
# EDGEONE_FUNCTION_STRICT=0
# EDGEONE_PURGE_STRICT=0
# EDGEONE_HTML_CACHE_STRICT=0
