# nginx server block fragment (merge into your server config)
# NOTE: `include mime.types` keeps the default MIME table; the `types` block below only adds
# extensions missing from older nginx builds. Without it, X-Content-Type-Options: nosniff
# would cause CSS/JS to be rejected as application/octet-stream.
server {
    listen 80;
    server_name www.maibida.com maibida.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    server_name www.maibida.com maibida.com;
    include mime.types;
    default_type application/octet-stream;
    types { image/webp webp; video/mp4 mp4; }
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    location ~* \.(webp|png|jpg|jpeg|gif|svg|ico|css|js|woff2|mp4)$ {
        expires 365d;
        add_header Cache-Control "public, immutable";
        add_header Accept-Ranges "bytes" always;
    }
    error_page 404 /404.html;
    location = /404.html { internal; }
}
